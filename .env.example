# ─── Core ────────────────────────────────────────────────────────────────────
# development | test | staging | production  (production enforces s3 storage + secrets manager)
APP_ENV=development
DATABASE_URL=postgresql://creatorfarm:creatorfarm@localhost:5432/creatorfarm
REDIS_URL=redis://localhost:6379/0
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# Public base URL of the app (required behind a proxy / in production)
AUTH_URL=http://localhost:3000
# 32 random bytes, base64. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ─── Safety ──────────────────────────────────────────────────────────────────
# true = every AI provider and social platform call goes to an explicit mock adapter.
MOCK_MODE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# ─── Object storage ──────────────────────────────────────────────────────────
# local (filesystem, dev/test only) | s3 (AWS S3 or any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
S3_BUCKET=
S3_REGION=
# Only for S3-compatible services such as MinIO / R2:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ─── Secrets ─────────────────────────────────────────────────────────────────
# env = read provider keys from environment variables (dev) | aws = AWS Secrets Manager (prod)
SECRETS_DRIVER=env

# Provider credentials (dev only; in production store them in the secrets manager and
# reference them as aws-sm:<name>). Leave empty to keep a provider NOT_CONFIGURED.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=
GOOGLE_GENAI_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# ─── Workers ─────────────────────────────────────────────────────────────────
# Roles: generation, media, publishing, scheduler (comma-separated) or explicit queue names; empty = all
WORKER_QUEUES=
WORKER_HEALTH_PORT=9464
QUEUE_PREFIX=cf

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# Enables OpenTelemetry export from the web app when set (e.g. http://otel-collector:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=creator-farm-web

# ─── Seed (first run only) ───────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Farm Owner
# Global monthly hard budget in EUR. Without it, paid generation stays blocked.
SEED_MONTHLY_BUDGET_EUR=

# ── Security (phase 10) ──
# Roles that must use two-factor authentication. Default: OWNER,ADMIN in production/staging, none locally.
# MFA_REQUIRED_ROLES=OWNER,ADMIN
# Optional single sign-on (OpenID Connect); only existing accounts can sign in with it.
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Company SSO
# OIDC_IDP_ENFORCES_MFA=false
# Requests per minute: actions per user, API calls per client address.
# RATE_LIMIT_ACTIONS_PER_MINUTE=120
# RATE_LIMIT_API_PER_MINUTE=300
