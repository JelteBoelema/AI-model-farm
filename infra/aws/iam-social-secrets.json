{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WebManagesSocialTokens",
      "Effect": "Allow",
      "Action": ["secretsmanager:CreateSecret", "secretsmanager:PutSecretValue", "secretsmanager:GetSecretValue", "secretsmanager:DeleteSecret", "secretsmanager:TagResource"],
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${ACCOUNT_ID}:secret:creatorfarm/prod/social/*",
      "Condition": { "StringEquals": { "aws:PrincipalArn": "arn:aws:iam::${ACCOUNT_ID}:role/creator-farm-web" } }
    },
    {
      "Sid": "WorkerReadsAndRefreshesSocialTokens",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue", "secretsmanager:PutSecretValue"],
      "Resource": "arn:aws:secretsmanager:${AWS_REGION}:${ACCOUNT_ID}:secret:creatorfarm/prod/social/*",
      "Condition": { "StringEquals": { "aws:PrincipalArn": "arn:aws:iam::${ACCOUNT_ID}:role/creator-farm-worker" } }
    }
  ]
}
